pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
metadata:
  annotations:
    container.apparmor.security.beta.kubernetes.io/buildkit: unconfined
spec:
  containers:
  - name: buildkit
    image: moby/buildkit:rootless
    command:
    - sh
    - -c
    args:
    - sleep 1d
    env:
    - name: DOCKER_CONFIG
      value: /docker-config
    - name: BUILDKITD_FLAGS
      value: --oci-worker-no-process-sandbox
    securityContext:
      runAsUser: 1000
      runAsGroup: 1000
      seccompProfile:
        type: Unconfined
    volumeMounts:
    - name: docker-config
      mountPath: /docker-config
      readOnly: true
  restartPolicy: Never
  volumes:
  - name: docker-config
    projected:
      sources:
      - secret:
          name: dockercred
          items:
          - key: .dockerconfigjson
            path: config.json
'''
    }
  }

  stages {
    stage('Clone Repository') {
      steps {
        container('buildkit') {
          git url: 'https://github.com/PREngineer/prengineer.github.io',
              branch: 'master'
        }
      }
    }

    stage('Build and Push Multi-Architecture Image') {
      steps {
        container('buildkit') {
          sh '''
            buildctl-daemonless.sh build \
              --frontend dockerfile.v0 \
              --local context=. \
              --local dockerfile=. \
              --opt platform=linux/amd64,linux/arm64 \
              --output type=image,name=docker.io/prengineer/cvjp:latest,push=true
          '''
        }
      }
    }

    stage('Delete Previous Pods for ArgoCD Redeployment') {
      steps {
        sshagent(credentials: ['k3s']) {
          sh '''
            ssh -o StrictHostKeyChecking=no -l jlpc k3s \
              kubectl delete pods --all --namespace=cvjp
          '''
        }
      }
    }
  }
}